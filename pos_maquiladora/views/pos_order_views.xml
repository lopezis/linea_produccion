<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_order_consolidation_list" model="ir.ui.view">
        <field name="name">pos.order.consolidation.list</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <list string="Aprobaciones de Pedido" create="false"
                  default_group_by="delivery_date:day"
                  decoration-danger="production_stage == 'draft'"
                  decoration-success="production_stage != 'draft'">
                <header>
                    <button name="action_send_to_production" type="object"
                            string="Enviar a producción"
                            class="btn-primary"
                            icon="fa-industry"/>
                </header>
                <field name="name"/>
                <field name="delivery_date"/>
                <field name="partner_id"/>
                <field name="amount_total" string="Total" widget="monetary"
                       optional="show"/>
                <field name="production_stage" widget="badge"/>
                <field name="state" widget="badge" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pos_order_consolidation_search" model="ir.ui.view">
        <field name="name">pos.order.consolidation.search</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="delivery_date"/>
                <field name="production_stage"/>
                <group expand="0" string="Agrupado por">
                    <filter name="group_delivery_date" string="Fecha de Entrega"
                            context="{'group_by': 'delivery_date:day'}"/>
                    <filter name="group_production_stage" string="Etapa de Producción"
                            context="{'group_by': 'production_stage'}"/>
                </group>
                <separator/>
                <filter name="not_sent" string="Pendientes de envío"
                        domain="[('production_stage', '=', 'draft')]"/>
                <filter name="sent_to_production" string="Enviados a producción"
                        domain="[('production_stage', '!=', 'draft')]"/>
            </search>
        </field>
    </record>

    <record id="view_pos_order_consolidation_form" model="ir.ui.view">
        <field name="name">pos.order.consolidation.form</field>
        <field name="model">pos.order</field>
        <field name="priority" eval="99"/>
        <field name="arch" type="xml">
            <form string="Pedido" create="false" edit="false">
                <header>
                    <field name="production_stage" widget="statusbar"/>
                    <button name="action_send_to_production" type="object"
                            string="Enviar a producción"
                            class="btn-primary"
                            icon="fa-industry"
                            invisible="production_stage != 'draft'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_next_stage" type="object"
                                string="Siguiente Etapa"
                                class="oe_stat_button" icon="fa-arrow-right"
                                invisible="production_stage == 'paid'"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Referencia"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="delivery_date"/>
                            <field name="production_stage" widget="badge"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group>
                            <field name="session_id"/>
                            <field name="amount_total" widget="monetary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detalle de la Orden" name="order_lines">
                            <field name="lines" nolabel="1">
                                <list create="false" edit="false">
                                    <field name="product_id"/>
                                    <field name="qty"/>
                                    <field name="price_unit"/>
                                    <field name="discount"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notas" name="notes">
                            <field name="general_note" nolabel="1" placeholder="Nota general..."/>
                        </page>
                        <page string="Producción" name="production">
                            <group>
                                <field name="production_stage" widget="badge"/>
                                <field name="sewing_line_ids">
                                    <list editable="bottom">
                                        <field name="operator_id"/>
                                        <field name="quantity"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_order_consolidation_action" model="ir.actions.act_window">
        <field name="name">Consolidación y Envío</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_pos_order_consolidation_list"/>
        <field name="search_view_id" ref="view_pos_order_consolidation_search"/>
        <field name="context">{'create': False}</field>
        <field name="groups_id"
               eval="[(4, ref('mrp_pos_workflow.group_production_manager'))]"/>
    </record>

    <menuitem id="menu_pos_order_consolidation"
              name="Consolidación y Envío"
              parent="point_of_sale.menu_point_of_sale"
              action="pos_order_consolidation_action"
              sequence="20"
              groups="mrp_pos_workflow.group_production_manager"/>

</odoo>
