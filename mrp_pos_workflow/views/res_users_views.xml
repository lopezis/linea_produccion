<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_pos_config" model="ir.ui.view">
        <field name="name">res.users.form.inherit.mrp_pos_workflow</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="Producción" name="production_access">
                    <group string="Puntos de Venta Permitidos">
                        <field name="allowed_pos_config_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
