<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_production_line" model="ir.module.category">
        <field name="name">Línea de Producción</field>
        <field name="description">Gestión de la línea de producción secuencial del POS</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_production_operator" model="res.groups">
        <field name="name">Operador de Producción</field>
        <field name="category_id" ref="module_category_production_line"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_production_manager" model="res.groups">
        <field name="name">Administrador de Línea de Producción</field>
        <field name="category_id" ref="module_category_production_line"/>
        <field name="implied_ids" eval="[(4, ref('mrp_pos_workflow.group_production_operator'))]"/>
    </record>

    <record id="group_stage_pintado_corte" model="res.groups">
        <field name="name">Pintado y Corte</field>
        <field name="category_id" ref="module_category_production_line"/>
    </record>

    <record id="group_stage_plantilla" model="res.groups">
        <field name="name">Plantilla</field>
        <field name="category_id" ref="module_category_production_line"/>
    </record>

    <record id="group_stage_diseno" model="res.groups">
        <field name="name">Diseño</field>
        <field name="category_id" ref="module_category_production_line"/>
    </record>

    <record id="group_stage_suela" model="res.groups">
        <field name="name">Suela</field>
        <field name="category_id" ref="module_category_production_line"/>
    </record>

    <record id="group_stage_logistica" model="res.groups">
        <field name="name">Logística</field>
        <field name="category_id" ref="module_category_production_line"/>
    </record>

</odoo>
