<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="mrp_pos_workflow.production_display">
        <div class="o_production_display">
            <header class="o_production_toolbar">
                <div class="o_production_toolbar_title">
                    <h2 class="o_production_toolbar_heading">Línea de Producción</h2>
                    <span class="o_production_toolbar_hint">
                        <t t-if="!state.isAdmin">
                            <t t-esc="userName"/>
                        </t>
                        <t t-else="">
                            Vista completa del pipeline
                        </t>
                    </span>
                </div>
                <button type="button"
                        class="btn btn-light btn-sm o_production_refresh"
                        t-on-click="() => this.loadOrders()">
                    <i class="fa fa-refresh me-1"/>
                    Actualizar
                </button>
            </header>

            <t t-if="state.loading">
                <div class="o_production_loading">Cargando...</div>
            </t>
            <t t-else="">
                <div class="o_production_columns">
                    <t t-foreach="columns" t-as="column" t-key="column.key">
                        <div class="o_production_column">
                            <header class="o_production_column_header">
                                <t t-if="state.editingColumnKey === column.key">
                                    <div class="o_production_column_edit">
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               t-model="state.editingColumnLabel"
                                               t-on-keydown="(ev) => this.onEditKeydown(ev)"/>
                                        <button type="button"
                                                class="btn btn-success btn-sm"
                                                title="Guardar"
                                                t-on-click="() => this.saveColumnLabel()">
                                            <i class="fa fa-check"/>
                                        </button>
                                        <button type="button"
                                                class="btn btn-secondary btn-sm"
                                                title="Cancelar"
                                                t-on-click="() => this.cancelEditColumn()">
                                            <i class="fa fa-times"/>
                                        </button>
                                    </div>
                                </t>
                                <t t-else="">
                                    <button type="button"
                                            class="o_production_column_title"
                                            t-att-disabled="!canRenameColumns"
                                            t-on-click="() => this.startEditColumn(column)">
                                        <span t-esc="column.label"/>
                                        <i t-if="canRenameColumns"
                                           class="fa fa-pencil o_production_column_edit_icon"/>
                                    </button>
                                    <span class="o_production_column_count badge"
                                          t-esc="ordersByStage[column.key].length"/>
                                </t>
                            </header>
                            <div class="o_production_cards">
                                <t t-foreach="ordersByStage[column.key]" t-as="order" t-key="order.id">
                                    <div class="o_production_card">
                                        <div class="o_production_card_body">
                                            <div class="o_production_card_ref">
                                                <i class="fa fa-receipt me-1"/>
                                                <span t-esc="order.name"/>
                                            </div>
                                            <div class="o_production_card_qty">
                                                <span t-esc="order.qty"/> pares
                                            </div>
                                            <div class="o_production_card_client">
                                                <i class="fa fa-user me-1"/>
                                                <span t-esc="order.partner_name"/>
                                            </div>
                                            <div class="o_production_card_delivery"
                                                 t-att-class="order.deliveryDateDisplay.urgent ? 'text-danger fw-bold' : ''">
                                                <i class="fa fa-calendar me-1"/>
                                                Entrega: <span t-esc="order.deliveryDateDisplay.label"/>
                                            </div>
                                            <div class="o_production_card_notes" t-if="order.note">
                                                <i class="fa fa-sticky-note me-1"/>
                                                <span t-esc="order.note"/>
                                            </div>
                                            <div class="o_production_card_line_notes" t-if="order.line_notes.length">
                                                <t t-foreach="order.line_notes" t-as="line_note" t-key="line_note_index">
                                                    <div class="o_production_card_line_note">
                                                        <t t-if="line_note.product_name">
                                                            <strong t-esc="line_note.product_name"/>:
                                                        </t>
                                                        <t t-if="line_note.note">
                                                            <span t-esc="line_note.note"/>
                                                        </t>
                                                        <t t-if="line_note.note and line_note.customer_note">
                                                            <br/>
                                                        </t>
                                                        <t t-if="line_note.customer_note">
                                                            <span t-esc="line_note.customer_note"/>
                                                        </t>
                                                    </div>
                                                </t>
                                            </div>
                                            <t t-if="order.production_stage === 'logistica'">
                                                <button type="button"
                                                        class="btn btn-outline-primary btn-sm w-100 o_assign_sewer_btn"
                                                        t-on-click="() => this.openAssignDialog(order)">
                                                    <i class="fa fa-cut me-1"/>
                                                    Asignar Costurera/o
                                                </button>
                                            </t>
                                        </div>
                                        <footer class="o_production_card_footer">
                                            <button type="button"
                                                    class="btn btn-primary btn-sm"
                                                    t-if="order.production_stage !== 'paid'"
                                                    t-on-click="() => this.liberateOrder(order)">
                                                Liberar
                                            </button>
                                            <button type="button"
                                                    t-att-class="order.production_stage === 'paid' ? 'btn btn-success btn-sm o_production_invoice_btn' : 'btn btn-outline-secondary btn-sm o_production_invoice_btn'"
                                                    t-att-disabled="order.production_stage !== 'paid'"
                                                    t-on-click="() => this.generateInvoice(order)">
                                                <i class="fa fa-file-text me-1"/>
                                                Recibo/Factura
                                            </button>
                                            <button type="button"
                                                    class="btn btn-secondary btn-sm"
                                                    t-on-click="() => this.showDetails(order)">
                                                Detalles
                                            </button>
                                        </footer>
                                    </div>
                                </t>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </div>

        <t t-if="state.selectedOrder">
            <div class="o_production_modal_backdrop" t-on-click="() => this.closeDetails()">
                <div class="o_production_modal" t-on-click.stop="() => {}">
                    <header class="o_production_modal_header">
                        <h3>Detalles del pedido</h3>
                        <button type="button"
                                class="btn-close"
                                aria-label="Cerrar"
                                t-on-click="() => this.closeDetails()"/>
                    </header>
                    <div class="o_production_modal_body">
                        <t t-if="state.detailsLoading">
                            <div class="o_production_loading">Cargando detalles...</div>
                        </t>
                        <t t-else="">
                            <div class="o_production_modal_info">
                                <div><strong>Referencia:</strong> <span t-esc="state.selectedOrder.name"/></div>
                                <div><strong>Cliente:</strong> <span t-esc="state.selectedOrder.partner_name"/></div>
                                <div><strong>Entrega:</strong> <span t-esc="state.selectedOrder.deliveryDateDisplay.label"/></div>
                                <div class="o_production_modal_note">
                                    <strong>Notas:</strong>
                                    <span t-esc="state.selectedOrder.note"/>
                                </div>
                            </div>
                            <table class="table table-sm o_production_modal_table">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-end">Cantidad</th>
                                        <th>Nota</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.selectedOrder.lines" t-as="line" t-key="line.id">
                                        <tr>
                                            <td t-esc="line.product_name"/>
                                            <td class="text-end" t-esc="line.qty"/>
                                            <td>
                                                <t t-if="line.note">
                                                    <span t-esc="line.note"/>
                                                </t>
                                                <t t-if="line.note and line.customer_note">
                                                    <br/>
                                                </t>
                                                <t t-if="line.customer_note">
                                                    <span t-esc="line.customer_note"/>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </t>
</templates>
